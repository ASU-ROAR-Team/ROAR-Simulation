<?xml version="1.0"?>
<robot name="erc_panel" xmlns:xacro="http://www.ros.org/wiki/xacro">
 <material name="dark_grey">
  <color rgba="0.500 0.500 0.500 1.000"/>
</material> <!-- dark grey material defined here for switches -->
  <!-- include switch macro -->
  <xacro:include filename="$(find switch_description)/urdf/rotary_control.xacro"/>

  <!-- world anchor -->
  <link name="world"/>

  <!-- panel base -->
   <xacro:include filename="$(find panel_body_description)/urdf/panel_body.xacro"/>
 <!-- attach panel base to world -->
   <joint name="world_to_panel" type="fixed">
  <parent link="world"/>
  <child link="panel_base_link"/>
  <origin xyz="0 0.0 0" rpy="0 0 0"/>
</joint>
<link name="panel_face"/>

<joint name="panel_to_face" type="fixed"> <!--Added this to attach switches directly to the tilted panel face-->
  <parent link="panel_base_link"/>
  <child link="panel_face"/>
  <origin xyz="0 -0.17 0.082" rpy="-0.5236 0 0"/>
</joint>
  <!-- Rotary control switches -->
  <!-- x:left/right y:forward/backward z:down -->
  <xacro:rotary_switch name="rotary_1" parent="panel_face"
    x="-0.13" y="0.00" z="-0.015"/>
  <xacro:rotary_switch name="rotary_2" parent="panel_face"
    x="-0.065" y="0.00" z="-0.015"/>
  <xacro:rotary_switch name="rotary_3" parent="panel_face"
    x="0.000" y="0.00" z="-0.015"/>
  <xacro:rotary_switch name="rotary_4" parent="panel_face"
    x="0.065" y="0.00" z="-0.015"/>
  <xacro:rotary_switch name="rotary_5" parent="panel_face"
    x="0.13" y="0.00" z="-0.015"/>

<!-- 2 large rotary switches -->
<!-- x:left/right y:forward/backward z:down -->
<xacro:include filename="$(find rotary_description)/urdf/rotary.xacro"/>
<xacro:rotary name="large_rotary_1" parent="panel_face" x="0.04" y="0.05" z="-0.15"/>
<xacro:rotary name="large_rotary_2" parent="panel_face" x="0.125" y="0.05" z="-0.15"/>
<!-- row of switches -->
<!-- x:left/right y:forward/backward z:down-->
<xacro:include filename="$(find row_description)/urdf/row.xacro"/>
<xacro:row name="row_1"  parent="panel_face" x="-0.138"   y="0.005" z="0.1"/>
<xacro:row name="row_2"  parent="panel_face" x="-0.12075" y="0.005" z="0.1"/>
<xacro:row name="row_3"  parent="panel_face" x="-0.1035"  y="0.005" z="0.1"/>
<xacro:row name="row_4"  parent="panel_face" x="-0.08625" y="0.005" z="0.1"/>
<xacro:row name="row_5"  parent="panel_face" x="-0.069"   y="0.005" z="0.1"/>
<xacro:row name="row_6"  parent="panel_face" x="-0.05175" y="0.005" z="0.1"/>
<xacro:row name="row_7"  parent="panel_face" x="-0.0345"  y="0.005" z="0.1"/>
<xacro:row name="row_8"  parent="panel_face" x="-0.01725" y="0.005" z="0.1"/>
<xacro:row name="row_9"  parent="panel_face" x="0.0"      y="0.005" z="0.1"/>
<xacro:row name="row_10" parent="panel_face" x="0.01725"  y="0.005" z="0.1"/>
<xacro:row name="row_11" parent="panel_face" x="0.0345"   y="0.005" z="0.1"/>
<xacro:row name="row_12" parent="panel_face" x="0.05175"  y="0.005" z="0.1"/>
<xacro:row name="row_13" parent="panel_face" x="0.069"    y="0.005" z="0.1"/>

<!-- 2 sockets -->
<!-- x:left  y:forward/backward z:down -->
<xacro:include filename="$(find socket_description)/urdf/socket.xacro"/>
<xacro:socket name="socket_1" parent="panel_face" x="-0.07 " y="0" z="-0.1"/>
<xacro:socket name="socket_2" parent="panel_face" x="-0.07" y="0" z="-0.135"/>
</robot>
