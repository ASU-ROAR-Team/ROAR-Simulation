<launch>
    <arg name="x" default="0.0" />
    <arg name="y" default="0.0" />
    <arg name="z" default="0.5" />
    <arg name="yaw" default="-1.5708"/> <!-- -90 degrees -->

    <!-- Launch an empty Gazebo world -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch"/> 
    
    <param name="robot_description" command="$(find xacro)/xacro '$(find roar_simulation)/urdf/base/rover_simulation.urdf.xacro'" />

    <!-- Spawn the robot model from the robot_description parameter into Gazebo -->
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" output="screen"
          args="-urdf -model roar_rover -param robot_description 
                -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)" />

    <!-- Load joint controller configurations from a rover-specific YAML file -->
    <rosparam file="$(find roar_simulation)/config/rover_controllers.yaml" command="load"/>
    
    <!-- Spawn the rover's wheel controllers -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
          output="screen" args="joint_state_controller 
                               wheel_lhs_front_velocity_controller 
                               wheel_lhs_mid_velocity_controller 
                               wheel_lhs_rear_velocity_controller 
                               wheel_rhs_front_velocity_controller 
                               wheel_rhs_mid_velocity_controller 
                               wheel_rhs_rear_velocity_controller" />

    <!-- Publishes TF transforms for the robot based on the robot_description and joint_states -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <!-- The joint_state_controller already publishes /joint_states from Gazebo.
         This joint_state_publisher node is often used for manual control with a GUI -->
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />

    <!-- The ground truth TF is now published by the 'libgazebo_ros_p3d.so' plugin
         we included in rover_gazebo.xacro, so this external script is no longer needed.
    <node pkg="roar_simulation" type="ground_truth_tf_broadcaster.py" name="ground_truth_tf_broadcaster" output="screen" /> 
    -->

    <!-- Start your teleoperation node to drive the rover -->
    <node pkg="roar_simulation" type="teleop.py" name="teleop_node" output="screen" />

</launch>